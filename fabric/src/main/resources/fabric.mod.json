{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "${mod_github}",
        "issues": "${mod_github}/issues"
    },
    "license": "${mod_license}",
    "icon": "${mod_icon}",
    "environment": "*",
    "entrypoints": {},
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "java": ">=${java_version}",
        "minecraft": ">=${minecraft_version}",
        "fabricloader": ">=${fabric_loader_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}